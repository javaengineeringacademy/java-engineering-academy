<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback configuration for Mini Banking System.

    Engineering Decision: Logback over Log4j2.
    WHY: Logback is the native SLF4J implementation with better performance,
    simpler configuration, and automatic reload capabilities. It's the
    recommended choice for new SLF4J-based projects.
-->
<configuration>
    <!-- Console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId}] [%X{accountId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for production -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/banking.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/banking.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId}] [%X{accountId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Application logger -->
    <logger name="academy.javaengineering.minibanking" level="DEBUG" />

    <!-- Suppress verbose logging from dependencies -->
    <logger name="org.springframework" level="WARN" />
</configuration>
